########### PREPROCESSING SCRIPT ###########
#
# Script for color camera preprocessing
#
# Needs 2 sets of RAW images in the working
# directory, within 4 directories:
#   darks/
#   lights/
#
############################################
#
# MODIFIED BY: Aliaksei Chernik
# DATE: October 2026
# CHANGES: 
#   - Removed the final "stack" command.
#   - This script now performs calibration and registration 
#     only. Stacking is handled separately by the AstroProv 
#     Python pipeline after manual frame selection.
#
# This modified version is distributed under the 
# same license: GPL-3.0-or-later
#
############################################

requires 1.2.0

# Convert Dark Frames to .fit files
cd darks
convert dark -out=../process
cd ../process

# Stack Dark Frames to dark_stacked.fit
stack dark rej 3 3 -nonorm
cd ..

# Convert Light Frames to .fit files
cd lights
convert light -out=../process
cd ../process

# Pre-process Light Frames
calibrate light -dark=dark_stacked -cfa -equalize_cfa -debayer

# Align lights
register pp_light
